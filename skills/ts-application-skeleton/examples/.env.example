# Optional: mock mode works without any .env file or API key.
AI_MODE=mock

# Only used when AI_MODE=live. Never use a VITE_ prefix for this secret.
OPENROUTER_API_KEY=
# Pi chat model.
OPENROUTER_MODEL=openai/gpt-4.1-mini

# TypeSafe System One model for decisions (independent of Pi).
OPENROUTER_DECISION_MODEL=typesafe/jev-1.13

# Production listener only. Portless assigns the dev port.
# Local app, without authentication.
HOST=127.0.0.1
PORT=3000

# Local SQLite data; relative paths resolve from the application directory.
APP_DATA_DIR=.data

# Debug, Info, Warn, Error, or None. Logs omit prompts and secrets.
LOG_LEVEL=Info
