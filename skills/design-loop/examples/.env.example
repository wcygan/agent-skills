# Optional: mock mode works without any .env file or API key.
AI_MODE=mock

# Only used when AI_MODE=live. Never use a VITE_ prefix for this secret.
OPENROUTER_API_KEY=
# Pi chat model.
OPENROUTER_MODEL=openai/gpt-4.1-mini

# Dev and production listeners; 0.0.0.0 includes the Tailscale interface.
# Use mock sample data: this prototype has no authentication.
HOST=0.0.0.0
PORT=5173

# Dev discovers Tailscale automatically; optional manual exact hostname override.
# __VITE_ADDITIONAL_SERVER_ALLOWED_HOSTS=your-host.your-tailnet.ts.net

# Local SQLite data; relative paths resolve from the application directory.
APP_DATA_DIR=.data

# Debug, Info, Warn, Error, or None. Logs omit prompts and secrets.
LOG_LEVEL=Info
